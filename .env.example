# ---------- Database (required) ----------
# Postgres connection strings. Easiest local setup: `docker compose up -d`
# (see docker-compose.yml) creates both databases with these exact
# credentials. Alternatively point these at a hosted provider (Neon,
# Supabase, Railway, RDS, etc) — see the README's "Database: Postgres"
# section for details either way.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleet_ops

# A SEPARATE database used only by the test suite (`npm test`) — never your
# dev data. Tests DROP and recreate this database's schema on every run, so
# it must not be the same database as DATABASE_URL above.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/fleet_ops_test

# ---------- Google Maps (optional) ----------
# The app works without these (route optimization falls back to selection
# order, and the live map shows a placeholder), but add both to unlock BR-06
# route optimization and BR-12 live vehicle tracking.
#
# GOOGLE_MAPS_API_KEY: server-side only, used to call the Directions API when
# a trip is created. Keep this one secret — do not prefix with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=

# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: used by the browser to load the Maps JS
# SDK for the Dispatcher console's live vehicle map. This one IS exposed to
# the browser (that's what NEXT_PUBLIC_ means) — restrict it in the Google
# Cloud Console to your domain (HTTP referrer restriction) rather than
# treating it as a secret.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
